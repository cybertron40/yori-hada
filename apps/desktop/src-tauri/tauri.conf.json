{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Recipe Atlas",
  "identifier": "com.recipeatlas.desktop",
  "version": "0.1.0",
  "build": {
    "beforeDevCommand": "pnpm --filter @recipe-manager/web dev",
    "beforeBuildCommand": "pnpm --filter @recipe-manager/web build",
    "devPath": "http://localhost:3000",
    "distDir": "../web/.next"
  },
  "app": {
    "withGlobalTauri": true
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "open": true
      }
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "Recipe Atlas",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "bundle": {
      "active": true,
      "targets": "all",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png"
      ]
    }
  }
}
